{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "baseline", "phase", "owner", "assignments", "decisions", "pending_work", "tests", "checkpoint"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "commit"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "phase": {"type": "string", "enum": ["scope", "reviews", "challenge", "synthesis", "edits", "verification", "checkpoint", "complete", "blocked"]},
    "owner": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["identity", "paths"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "reviewer", "status", "inspected_commit", "input_hashes", "report"],
        "properties": {
          "role": {"type": "string", "enum": ["chair", "training", "nutrition", "micronutrients", "coaching", "measurement", "safety", "product", "product-designer", "ux-accessibility", "architecture", "flutter", "integrations", "privacy-security", "qa"]},
          "reviewer": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pending", "complete", "stale", "omitted"]},
          "inspected_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
          "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "report": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "summary", "authority"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["accepted", "rejected", "pending"]},
          "summary": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "pending_work": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "commit", "dirty", "exit_code", "result", "summary"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "dirty": {"type": "boolean"},
          "exit_code": {"type": ["integer", "null"]},
          "result": {"type": "string", "enum": ["not-run", "passed", "failed"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["at", "writers_stopped"],
      "properties": {
        "at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "writers_stopped": {"type": "boolean"}
      }
    }
  }
}
