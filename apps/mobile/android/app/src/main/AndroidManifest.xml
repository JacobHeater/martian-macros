<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Out of the phone's cloud backup and its transfer to a new phone
         (MM-65, MM-157): see res/xml/data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect asks the app to explain its permissions
                 (MM-68) on Android 13 and earlier. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

        </activity>

        <!-- The same question on Android 14 and later (MM-68). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The live barcode view (MM-43). -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- A reminder at its time, and setting them again after a restart
             (MM-146) or once exact alarms are allowed (MM-248). -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".ReminderBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Used only to download the optional food database the user asks for
         (MM-56), and to move the user's records to their other phone on the
         same Wi-Fi when they choose to (MM-697). The app sends no analytics
         and uploads nothing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To find this phone's Wi-Fi address for a move to another phone
         (MM-697). Granted at install; it asks nothing of the user. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reading barcodes and nutrition labels (MM-43, MM-44), on the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Reminders the user turns on (MM-146) are scheduled on the device.
         After a restart Android forgets them, so they are set again. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- So a reminder arrives at the time the user set rather than up to an
         hour later (MM-248, the owner's call 2026-10-13). Asked for once,
         from the reminder settings, never on first run; declined, reminders
         are scheduled inexactly and nothing else changes. Not
         USE_EXACT_ALARM: alarms are not this app's core function. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Health Connect (MM-68): read only what the user grants one by one
         in Settings. Nothing read leaves the device. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Reading further back than thirty days before the first grant (MM-73). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Sleep sessions, for the nightly record (MM-250). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Writing (MM-70, MM-314, MM-513, MM-489): each asked for by itself, apart from
         reading, only when the user turns that kind on in Settings. Only what
         is logged in the app is written, and only the app's own records are
         ever changed or removed. -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- Whether Health Connect is on the device (MM-68). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
