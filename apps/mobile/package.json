{
  "name": "martian-macros-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project rules --project screens --project screens-css",
    "build": "vite build",
    "offline": "node scripts/check-offline.mjs",
    "legal": "node scripts/legal-page.mjs",
    "unseen": "vitest run --project stories --coverage && node scripts/check-unseen.mjs",
    "android": "vite build && cap telemetry off && cap sync android",
    "ios": "vite build && cap telemetry off && cap sync ios",
    "storybook": "storybook dev -p 6006 --no-version-updates",
    "build-storybook": "storybook build",
    "check": "npm run typecheck && npm run test && npm run unseen && npm run build && npm run offline && npm run legal"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "libsodium-wrappers-sumo": "0.8.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/libsodium-wrappers-sumo": "0.8.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "27.0.1",
    "storybook": "^10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
