  "fixed_sql": [
    {
      "name": "setups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"setups\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"sex\" TEXT NOT NULL CHECK(\"sex\" IN ('male', 'female')), \"birth_epoch_day\" INTEGER NOT NULL, \"height_cm\" REAL NOT NULL, \"training_status\" TEXT NOT NULL, \"training_days_per_week\" INTEGER NOT NULL, \"goal_mode\" TEXT NOT NULL, \"unit_system\" TEXT NOT NULL, \"onboarded_epoch_day\" INTEGER NOT NULL, \"body_fat_percent\" REAL NULL, \"requested_loss_fraction\" REAL NULL, \"pregnant\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pregnant\" IN (0, 1)), \"breastfeeding\" INTEGER NOT NULL DEFAULT 0 CHECK (\"breastfeeding\" IN (0, 1)), \"eating_disorder_history\" INTEGER NOT NULL DEFAULT 0 CHECK (\"eating_disorder_history\" IN (0, 1)), \"chronic_kidney_disease\" INTEGER NOT NULL DEFAULT 0 CHECK (\"chronic_kidney_disease\" IN (0, 1)), \"androgen_use\" INTEGER NOT NULL DEFAULT 0 CHECK (\"androgen_use\" IN (0, 1)), \"pcos\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pcos\" IN (0, 1)), \"menopause\" INTEGER NOT NULL DEFAULT 0 CHECK (\"menopause\" IN (0, 1)), \"thyroid_condition\" INTEGER NOT NULL DEFAULT 0 CHECK (\"thyroid_condition\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "weight_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weight_entries\" (\"epoch_day\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL CHECK(\"weight_kg\" BETWEEN 20.0 AND 500.0), \"device_id\" TEXT NULL, PRIMARY KEY (\"epoch_day\"));"
        }
      ]
    },
